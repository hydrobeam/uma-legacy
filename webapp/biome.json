{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.ts",
      "src/**/*.tsx",
      "*.mjs",
      ".size-limit.mjs",
      "vite/*.mjs",
      "chibi/*.mjs",
      "test/**/*.mjs",
      "test/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "useButtonType": "error", "useKeyWithClickEvents": "error" },
      "complexity": { "noUselessFragments": "error" },
      "correctness": {
        "noChildrenProp": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "nursery": { "noFloatingPromises": "info" },
      "style": {
        "noNonNullAssertion": "error",
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "localStorage": "storage is reached through storage.ts (read, readJson; the one write is update, which reads what is stored now)",
              "sessionStorage": "storage is reached through storage.ts (read, readJson; the one write is update, which reads what is stored now)"
            }
          }
        },
        "useImportType": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@preact/signals": {
                "importNames": ["effect"],
                "message": "only store.ts makes an effect: name its signals with on([a, b], (a, b) => ...)"
              },
              "@preact/signals-core": "signals come from @preact/signals alone: one package, so one signal graph (a second copy of core, nested by npm, would leave its signals' effects unseen)"
            }
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noDuplicateJsxProps": "error",
        "noEmptyBlockStatements": "error",
        "noImportCycles": "error",
        "noTsIgnore": "error"
      }
    }
  },
  "plugins": [
    { "path": "./lint/effects.grit", "includes": ["src/**", "!src/store.ts"] },
    { "path": "./lint/mutable-export.grit", "includes": ["src/**"] },
    { "path": "./lint/storage-write.grit", "includes": ["src/**", "!src/storage.ts"] }
  ],
  "overrides": [
    {
      "includes": ["src/storage.ts", "test/**"],
      "linter": { "rules": { "style": { "noRestrictedGlobals": "off" } } }
    },
    {
      "includes": ["src/store.ts", "test/**"],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      "includes": ["**/*.js", "**/*.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
