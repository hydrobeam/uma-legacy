{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**/*.js",
      "src/**/*.mjs",
      "src/**/*.ts",
      "src/**/*.tsx",
      "*.mjs",
      "chibi/*.mjs",
      "worker.template.js",
      "test/**/*.mjs",
      "test/**/*.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "useButtonType": "error", "useKeyWithClickEvents": "error" },
      "complexity": { "noUselessFragments": "error" },
      "correctness": {
        "noChildrenProp": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error",
        "useJsxKeyInIterable": "error"
      },
      "nursery": { "noFloatingPromises": "info" },
      "style": { "noNonNullAssertion": "error", "useImportType": "error" },
      "suspicious": { "noArrayIndexKey": "error", "noDuplicateJsxProps": "error", "noEmptyBlockStatements": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.js", "**/*.mjs"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  }
}
