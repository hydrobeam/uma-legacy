{
  // The page's plain JS: checkJs with strictNullChecks, not yet the rest of strict (each module converts to .ts, strict,
  // in its own commit).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "strictNullChecks": true
  },
  "include": ["src/**/*.js", "src/**/*.mjs", "src/globals.d.ts"]
}
