// knip (./build.sh lint): files no entry reaches, exports no other file imports, dependencies nothing uses and imports
// of packages not in package.json or of files that do not exist. An export a test reaches only through an esbuild
// bundle written as a string (test/unit's views tests) is marked `@public` where it is declared, with why.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/worker.ts", "test/**/*.{mjs,ts}", "*.mjs", "chibi/*.mjs"],
  "project": ["src/**/*.{ts,tsx}", "test/**/*.{mjs,ts}", "vite/**/*.mjs", "*.mjs", "chibi/*.mjs"],
  "rules": {
    // exported types and interfaces stay unchecked, as before knip (24 are used only in their own module)
    "types": "off"
  },
  "ignoreDependencies": [
    // run by build.sh, which knip does not read: wasm-opt (wasm), Biome and dependency-cruiser (lint), wrangler (deploy)
    "binaryen",
    "@biomejs/biome",
    "dependency-cruiser",
    "wrangler",
    // dependency-cruiser's parser (.dependency-cruiser.mjs `parser: 'swc'`)
    "@swc/core",
    // imported by src/style.css, which knip does not read
    "@fontsource/.+",
    // served to the runner pages from node_modules by chibi/render.mjs
    "three"
  ]
}
