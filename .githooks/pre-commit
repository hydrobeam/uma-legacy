#!/bin/sh
# Checks what a commit stages, by kind (enabled by ./build.sh hooks: git config core.hooksPath .githooks):
#   Rust under pkg/loopopt: cargo fmt --check and clippy, warnings denied (native, dev profile: about 5 s after a change,
#     a minute the first time in a new worktree); clippy on the wasm lib stays in ./build.sh lint and CI
#   Python: ruff check and ruff format --check on the staged files (well under a second)
#   the page's JS: Biome (lint and formatting) on the staged files, then tsc's checkJs over the page (under a second)
#   the page's JS, CSS or templates: webapp/test/static.mjs (no dead CSS, no dead exports; well under a second)
#   the page's sources or tests: the node tests, webapp/test/unit/ (well under a second)
# A commit staging none of these (docs, data) checks nothing. ./build.sh lint runs every check on the whole repo.
root=$(git rev-parse --show-toplevel) || exit 1
staged() { git diff --cached --name-only --diff-filter=ACMR -- "$@"; }
fail() { printf 'pre-commit: %s\n' "$1" >&2; exit 1; }

if [ -n "$(staged 'pkg/loopopt/*.rs')" ]; then
  (cd "$root/pkg/loopopt" && cargo fmt --check --message-format short) || fail 'Rust formatting differs (cargo fmt in pkg/loopopt fixes it)'
  (cd "$root/pkg/loopopt" && cargo clippy --quiet --offline --all-targets -- -D warnings) || fail 'clippy warnings (above)'
fi

py=$(staged '*.py')
if [ -n "$py" ]; then
  # shellcheck disable=SC2086 # one path per word: the repo's paths have no spaces
  (cd "$root" && uv run --quiet ruff check $py && uv run --quiet ruff format --check $py) || fail 'ruff (above; ruff format fixes formatting)'
fi

js=$(staged 'webapp/*.js' 'webapp/*.mjs' 'webapp/*.ts' 'webapp/*.tsx' | sed 's#^webapp/##')
if [ -n "$js" ]; then
  # shellcheck disable=SC2086 # as above
  (cd "$root/webapp" && npx --no-install biome check --error-on-warnings --diagnostic-level=warn --no-errors-on-unmatched $js \
    && npx --no-install tsc -p . && npx --no-install tsc -p tsconfig.js.json \
    && npx --no-install tsc -p tsconfig.worker.json) || fail 'Biome or tsc (above; npx biome format --write in webapp fixes formatting)'
fi

if [ -n "$(staged 'webapp/src/*' 'webapp/*.template.*' 'webapp/build.py')" ]; then
  (cd "$root/webapp" && node test/static.mjs >&2) || fail 'static checks (above: dead CSS or exports, a stale storage write)'
fi

if [ -n "$(staged 'webapp/src/*' 'webapp/test/*')" ]; then
  (cd "$root/webapp" && NODE_OPTIONS=--max-old-space-size=1024 node --test --test-timeout=60000 --test-reporter=dot 'test/unit/*.test.*' >&2) || fail 'node tests (above)'
fi
exit 0
