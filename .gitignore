# whitelist: only the project is tracked; scratch experiments, binaries and downloads stay out
/*
!/.gitignore
!/.git-blame-ignore-revs
!/.githooks/
!/.github/
!/build.sh
!/README.md
!/AGENTS.md
!/LICENSE
!/rust-toolchain.toml
!/pyproject.toml
!/uv.lock
!/.python-version
!/docs/
!/pkg/
/pkg/*
!/pkg/loopopt/
/pkg/loopopt/*
!/pkg/loopopt/src/
!/pkg/loopopt/tests/
!/pkg/loopopt/export/
!/pkg/loopopt/data/
!/pkg/loopopt/Cargo.toml
!/pkg/loopopt/Cargo.lock
!/pkg/loopopt/rustfmt.toml
!/webapp/
/webapp/*
!/webapp/build.py
!/webapp/index.template.html
!/webapp/about.template.html
!/webapp/career.template.html
!/webapp/panels.template.html
!/webapp/src/
!/webapp/test/
!/webapp/worker.template.js
!/webapp/example.mjs
!/webapp/example.json
!/webapp/nodebench.mjs
!/webapp/nodebrowser.mjs
!/webapp/serve.mjs
!/webapp/images.py
!/webapp/icons.py
!/webapp/icons.mjs
!/webapp/icons/
# the runner strips' pipeline (its tools and outputs stay out: cache/chibi, webapp/img/run)
!/webapp/chibi/
!/webapp/package.json
!/webapp/package-lock.json
!/webapp/biome.json
!/webapp/tsconfig.json
!/val/
/val/*
!/val/runval.py
!/val/test_validation.py
!/val/same.py
!/val/simval.py
!/val/slow.json
!/val/cmp2.py
!/val/jobs.json
!/val/ref__*.out
!/val/ref_times.txt
!/val/planval.py
!/val/mono.py
!/val/capaudit.py
!/val/plan/
/val/plan/*
!/val/plan/*.json
!/val/plan/ref__*.out
!/val/plan/ref_times.txt
!/val/refpu__*.out
!/val/career_job.py
!/val/umadump/
!/val/spark_gen_fit.py
!/val/cmp_ratio.py
!/val/event_audit.py
!/val/refpu_times.txt
!/val/secret_events.py
!/val/sim/
/val/sim/*
!/val/sim/README.md
!/val/sim/make_jobs.py
!/val/sim/report.py
!/val/sim/pools/
!/val/sim/jobs.json
!/val/sim/ref__*.out
!/val/jobs/
!/val/owncheck.py
!/val/permcheck.py
!/val/joint_check.py
!/val/milp_fixtures.py
# research scripts are tracked; the run records they read (research/data/) are not
!/research/
/research/data/
master.mdb
master.mdb.*
__pycache__/
