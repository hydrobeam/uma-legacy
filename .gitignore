# whitelist: only the project is tracked; scratch experiments, binaries and downloads stay out
/*
!/.gitignore
!/.git-blame-ignore-revs
!/.githooks/
!/.github/
!/build.sh
!/README.md
!/AGENTS.md
!/LICENSE
!/rust-toolchain.toml
!/pyproject.toml
!/uv.lock
!/.python-version
!/docs/
!/pkg/
/pkg/*
!/pkg/loopopt/
/pkg/loopopt/*
!/pkg/loopopt/src/
!/pkg/loopopt/tests/
!/pkg/loopopt/export/
!/pkg/loopopt/data/
!/pkg/loopopt/build.rs
!/pkg/loopopt/Cargo.toml
!/pkg/loopopt/Cargo.lock
!/pkg/loopopt/rustfmt.toml
!/webapp/
/webapp/*
# the pages (Vite's entries), their partials, the build's config and plugins, the page budgets
!/webapp/index.html
!/webapp/loop.html
!/webapp/about.html
!/webapp/partials/
!/webapp/vite.config.mjs
!/webapp/vite/
!/webapp/.size-limit.mjs
# the lint tools' configs: knip, dependency-cruiser, Biome's GritQL plugins
!/webapp/knip.jsonc
!/webapp/.dependency-cruiser.mjs
!/webapp/lint/
!/webapp/src/
!/webapp/test/
!/webapp/example.mjs
!/webapp/example.json
!/webapp/nodebench.mjs
!/webapp/playwright.config.mjs
!/webapp/images.py
!/webapp/icons.py
!/webapp/icons.mjs
# favicons and hosting rules, copied to the site's root as they are
!/webapp/public/
# the runner strips' pipeline (its tools and outputs stay out: cache/chibi, webapp/img/run)
!/webapp/chibi/
/webapp/chibi/node_modules/
# deploy's own packages (wrangler), installed by ./build.sh deploy only
!/webapp/deploy/
/webapp/deploy/node_modules/
!/webapp/package.json
!/webapp/package-lock.json
!/webapp/biome.json
!/webapp/tsconfig.json
!/webapp/tsconfig.worker.json
!/val/
/val/*
!/val/runval.py
!/val/test_validation.py
!/val/same.py
!/val/simval.py
!/val/slow.json
!/val/cmp2.py
!/val/jobs.json
!/val/ref__*.out
!/val/ref_times.txt
!/val/planval.py
!/val/mono.py
!/val/capaudit.py
!/val/career_check.py
!/val/plan/
/val/plan/*
!/val/plan/*.json
!/val/plan/ref__*.out
!/val/plan/ref_times.txt
!/val/refpu__*.out
!/val/career_job.py
!/val/make_pool.py
!/val/umadump/
!/val/spark_gen_fit.py
!/val/cmp_ratio.py
!/val/event_audit.py
!/val/refpu_times.txt
!/val/secret_events.py
!/val/sim/
/val/sim/*
!/val/sim/README.md
!/val/sim/make_jobs.py
!/val/sim/report.py
!/val/sim/fit_cont.py
!/val/sim/rollouts.py
!/val/sim/lam_regress.py
!/val/sim/v_level.py
!/val/sim/trace_pools.json
!/val/sim/pools/
!/val/sim/jobs.json
!/val/sim/ref__*.out
!/val/jobs/
!/val/owncheck.py
!/val/permcheck.py
!/val/joint_check.py
!/val/milp_fixtures.py
# research scripts are tracked; the run records they read (research/data/) are not
!/research/
/research/data
master.mdb
master.mdb.*
__pycache__/
